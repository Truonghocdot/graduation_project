APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESET_TOKEN_EXPIRES_SECONDS=600
OTP_TEST_CODE=123456

GOONG_BASE_URL=https://rsapi.goong.io
GOONG_API_KEY=
GOONG_CONNECT_TIMEOUT_SECONDS=3
GOONG_TIMEOUT_SECONDS=8
GOONG_RETRY_TIMES=2
GOONG_RETRY_DELAY_MILLISECONDS=200
GOONG_ROUTE_CACHE_TTL_SECONDS=300
QUOTE_TTL_SECONDS=300
PRICING_ROUNDING_UNIT=1000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=drive
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

VITE_APP_NAME="${APP_NAME}"
