APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESET_TOKEN_EXPIRES_SECONDS=600
OTP_TEST_CODE=123456

GOONG_BASE_URL=https://rsapi.goong.io
GOONG_API_KEY=
GOONG_CONNECT_TIMEOUT_SECONDS=3
GOONG_TIMEOUT_SECONDS=8
GOONG_RETRY_TIMES=2
GOONG_RETRY_DELAY_MILLISECONDS=200
GOONG_ROUTE_CACHE_TTL_SECONDS=300
QUOTE_TTL_SECONDS=300
PRICING_ROUNDING_UNIT=1000
TOPUP_TTL_MINUTES=30
WITHDRAWAL_MIN_AMOUNT=50000
WITHDRAWAL_MAX_AMOUNT=50000000
DRIVER_DAILY_COD_LIMIT=5000000
COD_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=drive
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MATCHING_PRESENCE_TTL_SECONDS=15
MATCHING_SEARCH_RADIUS_METERS=5000
MATCHING_BATCH_SIZE=5
MATCHING_OFFER_TTL_SECONDS=30
MATCHING_OUTBOX_CHANNEL=worker.outbox
DRIVER_LOCATION_CHANNEL=worker.location
EXECUTION_GEOFENCE_RADIUS_METERS=300

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_HOST=127.0.0.1
